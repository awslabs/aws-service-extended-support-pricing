{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AWS Service Extended Support Pricing",
  "description": "Schema for aws-service-extended-support-pricing v2. Each services[] entry is a rate card plus a match block that names exactly which aws-service-eol-data entries it prices.",
  "type": "object",
  "required": ["schemaVersion", "lastUpdated", "services"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^2\\.\\d+$" },
    "_disclaimer": { "type": "string" },
    "lastUpdated": { "type": "string", "format": "date" },
    "versionsRef": { "type": "string" },
    "joinKey": { "type": "string" },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["match", "serviceName", "pricingUnit", "formula", "tiers", "sourceUrl", "resourceInputs"],
        "not": { "anyOf": [ { "required": ["serviceCode"] }, { "required": ["engine"] } ] },
        "properties": {
          "match": {
            "type": "object",
            "description": "Join key into aws-service-eol-data. serviceCode and engine are copied exactly from the eol dataset (null means the service has no engine).",
            "required": ["serviceCode", "engine"],
            "additionalProperties": false,
            "properties": {
              "serviceCode": { "type": "string", "minLength": 1 },
              "engine": { "type": ["string", "null"] },
              "versionNumbers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 },
                "description": "Optional. When present, this entry prices only these eol versionNumbers. When absent, it prices every version of (serviceCode, engine)."
              },
              "capacityMode": {
                "enum": ["provisioned", "serverless-v2"],
                "description": "Optional. Aurora only. Supplied by the consumer from the resource, not from the eol dataset."
              }
            }
          },
          "serviceName": { "type": "string", "minLength": 1 },
          "pricingUnit": { "type": "string", "minLength": 1 },
          "formula": { "type": "string", "minLength": 1 },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label", "monthsFromEndOfStandardSupport"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "label": { "type": "string", "minLength": 1 },
                "monthsFromEndOfStandardSupport": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                },
                "rate": { "type": "number", "minimum": 0 },
                "rateByRegion": { "type": "boolean" },
                "multiplier": { "type": "number", "minimum": 0 },
                "instancePriceMultiplier": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Surcharge as a multiple of the on-demand instance price (1.0 = equal to the instance price)."
                }
              }
            }
          },
          "tierStartDates": {
            "type": "object",
            "description": "Optional per-version tier start dates from the AWS release calendars: versionNumber -> tier id -> ISO date, or null when that tier does not apply to the version. When a version is absent, fall back to monthsFromEndOfStandardSupport.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                  { "type": "null" }
                ]
              }
            }
          },
          "regionalRates": { "type": "object" },
          "normalizationFactors": { "type": "object" },
          "instanceClassMapping": { "type": "object" },
          "instanceRates": { "type": "object" },
          "resourceInputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["field", "source", "description"],
              "properties": {
                "field": { "type": "string" },
                "source": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          },
          "notes": { "type": ["string", "null"] },
          "examples": { "type": "array" },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://aws\\.amazon\\.com/|^https://docs\\.aws\\.amazon\\.com/"
          }
        }
      }
    }
  }
}
